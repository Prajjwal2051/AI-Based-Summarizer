# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# LLM Chat Model (e.g. gemma4:12b, gemma4:31b, qwen2.5-coder:7b)
OLLAMA_MODEL=gemma4:12b

# Embedding Model (e.g. embeddinggemma, nomic-embed-text)
OLLAMA_EMBED_MODEL=embeddinggemma

# Optional API key (required only for Ollama Cloud / https://ollama.com)
OLLAMA_API_KEY=

# Server configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
